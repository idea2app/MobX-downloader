{
    "name": "mobx-downloader",
    "version": "0.3.3",
    "license": "LGPL-3.0-or-later",
    "author": "shiy2008@gmail.com",
    "description": "File downloading SDK in Web browser, which is powered by MobX.",
    "keywords": [
        "file",
        "download",
        "mobx",
        "sdk",
        "model",
        "store",
        "state",
        "typescript"
    ],
    "homepage": "https://idea2app.github.io/MobX-downloader/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/idea2app/MobX-downloader.git"
    },
    "bugs": {
        "url": "https://github.com/idea2app/MobX-downloader/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "module": "dist/index.esm.js",
    "main": "dist/index.js",
    "dependencies": {
        "@swc/helpers": "^0.5.24",
        "koajax": "^3.3.1",
        "mobx": ">=6",
        "mobx-restful": "^2.1.5",
        "native-file-system-adapter": "^3.0.1",
        "regenerator-runtime": "^0.14.1",
        "web-streams-polyfill": "^4.5.1",
        "web-utility": "^4.8.1"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.16.4",
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-typescript-tsc": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@types/node": "^26.6.6",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "open-cli": "^9.0.0",
        "parcel": "~2.16.4",
        "prettier": "^3.9.10",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{md,ts,json,yml}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        }
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged",
        "build": "rm -rf .parcel-cache/ dist/ docs/  &&  typedoc source/  &&  parcel build",
        "start": "typedoc source/  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    }
}
