{
    "name": "mobx-downloader",
    "version": "0.3.1",
    "license": "LGPL-3.0-or-later",
    "author": "shiy2008@gmail.com",
    "description": "File downloading SDK in Web browser, which is powered by MobX.",
    "keywords": [
        "file",
        "download",
        "mobx",
        "sdk",
        "model",
        "store",
        "state",
        "typescript"
    ],
    "homepage": "https://idea2app.github.io/MobX-downloader/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/idea2app/MobX-downloader.git"
    },
    "bugs": {
        "url": "https://github.com/idea2app/MobX-downloader/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "module": "dist/index.esm.js",
    "main": "dist/index.js",
    "dependencies": {
        "@swc/helpers": "^0.5.15",
        "koajax": "^3.1.1",
        "mobx": "^6.13.6",
        "mobx-restful": "^2.1.0",
        "native-file-system-adapter": "^3.0.1",
        "regenerator-runtime": "^0.14.1",
        "web-streams-polyfill": "^4.1.0",
        "web-utility": "^4.4.2"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.13.3",
        "@parcel/packager-ts": "~2.13.3",
        "@parcel/transformer-typescript-tsc": "~2.13.3",
        "@parcel/transformer-typescript-types": "~2.13.3",
        "@types/node": "^22.13.4",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "open-cli": "^8.0.0",
        "parcel": "~2.13.3",
        "prettier": "^3.5.1",
        "typedoc": "^0.27.7",
        "typedoc-plugin-mdn-links": "^4.0.12",
        "typescript": "~5.7.3"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{md,ts,json,yml}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        }
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged",
        "build": "rm -rf .parcel-cache/ dist/ docs/  &&  typedoc source/  &&  parcel build",
        "start": "typedoc source/  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    }
}
